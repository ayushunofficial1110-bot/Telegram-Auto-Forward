# Telegram Bot API Token (obtained from @BotFather)
BOT_TOKEN=

# Telegram MTProto Credentials (obtained from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram MTProto Session String (generated via node generateSession.js)
TELEGRAM_SESSION=

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/telegram_reposter?retryWrites=true&w=majority

# Express Server Port (default 3000)
PORT=3000

# Admin Telegram User ID (numeric ID for accessing the Admin Panel and Broadcasts)
ADMIN_TELEGRAM_ID=

# Referral Ad-Free Threshold (number of completed referrals required to automatically activate adsFree: true, default 2)
REFERRAL_AD_FREE_THRESHOLD=2
